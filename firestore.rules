rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every collection (rooms, places, items, categories, meta) is private to the allow-listed account(s).
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'stoeffel.koch@gmail.com'
        ];
    }
  }
}
